\par }}}}\pard\plain \qj\li72\nowidctlpar\adjustright \fs24\cgrid {\fs18\expnd0\expndtw4\cf1\cgrid (Hotel Foresta) e Imperia (galleria Rond\'e0) a scandire i ritmi}{\fs18\expnd1\expndtw8\cf1\cgrid  }{\fs18\expnd1\expndtw6\cf1\cgrid del periodo forse}{
\fs18\expnd1\expndtw8\cf1\cgrid  }{\expnd0\expndtw-2\cf1\cgrid pia }{\fs18\expnd1\expndtw6\cf1\cgrid intenso della pittrice sebbene abbia}{\fs18\expnd1\expndtw8\cf1\cgrid  ormai superato i settant'anni.
\par }{\fs18\expnd1\expndtw6\cf1\cgrid E lo slancio prosegue con la personale di Milano presso la}{\fs18\expnd1\expndtw8\cf1\cgrid  galleria Cavour" di Renzo Cortina (aprile 1970). trenta dipinti e dieci disegni ordinati da Luigi Carluccio in un clima res
o effervescente da prestigiose presenze concomitanti in altre gallerie cittadine: Gino Moro, }{\fs18\expnd1\expndtw7\cf1\cgrid Giacomo Merli, Agenore Fabbri, Aligi Sassu, Ada Daverio,}{\fs18\expnd1\expndtw8\cf1\cgrid  Enzo Silvani.
\par }{\fs18\expnd1\expndtw5\cf1\cgrid Segue }{\fs18\expnd1\expndtw8\cf1\cgrid l}{\fs18\expnd1\expndtw8\super\cf1\cgrid '}{\fs18\expnd1\expndtw5\cf1\cgrid esposizione presso la galleria "S. Andrea" di Parma}{\fs18\expnd1\expndtw8\cf1\cgrid  }{\fs18\expnd1
\expndtw7\cf1\cgrid nella quale, ai dipinti della Maggioni, si accompagnano le}{\fs18\expnd1\expndtw8\cf1\cgrid  }{\fs18\expnd1\expndtw6\cf1\cgrid sculture di Ambrogio Casati, antico amico di famiglia che}{\fs18\expnd1\expndtw8\cf1\cgrid  nel 1966 era ven
uto a Diano a commemorare Gino in occasione della mostra dedicata alla sua attivit\'e0 di architetto e }{\fs20\i\cf1\cgrid designer
\par }\sa288\nowidctlpar\adjustright {\fs18\expnd1\expndtw8\cf1\cgrid Nuovi viaggi in Germania (1969) e in Austria (1970), ad }{\fs18\expnd1\expndtw6\cf1\cgrid Amburgo (1971) mantengono alta la temperie creativa di}{\fs18\expnd1\expndtw8\cf1\cgrid  Silvia
. }{\fs18\i\cf1\cgrid L}{\fs18\expnd1\expndtw8\super\cf1\cgrid '}{\fs20\i\cf1\cgrid Autoritratto }{\fs18\expnd1\expndtw8\cf1\cgrid del 1967 (cfr. scheda n\'b0208) \'e8 lo
