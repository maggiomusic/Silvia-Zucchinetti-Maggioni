\pard\plain \li11016\nowidctlpar\adjustright \fs24\cgrid {\fs18\expnd2\expndtw12\lang1033\cgrid 33
\par }}}}\pard\plain \s2\qj\nowidctlpar\adjustright \fs24\cgrid {\fs20\expnd0\expndtw-2\cgrid Ci\'f2 che meraviglia in questo ultimo periodo \'e8 una }{\fs20\expnd0\expndtw-4\cgrid straordinaria vitalit\'e0 che finisce per animare la pittura di}{\fs20
\expnd0\expndtw-2\cgrid  un'ansia creativa sorprendente in una persona ultraot.tantenne.
\par Brescia e Torino nel 1979 vedono le ultime personali }{\fs20\expnd0\expndtw-4\cgrid d'impegno, quella torinese in particolare presso la galleria}{\fs20\expnd0\expndtw-2\cgrid  d'arte "Emmedue}{\fs20\expnd0\expndtw-2\super\cgrid "}{\fs20\expnd0
\expndtw-2\cgrid  con trentotto quadri e cinque disegni. Poi \'e8 un rincorrersi di collettive di profilo molto vario tra }{\fs20\expnd0\expndtw-4\cgrid 1980 e 1981: Catanzaro, Viterbo, Diano Marina, San Leo,}{\fs20\expnd0\expndtw-2\cgrid  Parigi, Suzzara
, Bormio. I paesaggi a volte sono ingenui }{\fs20\expnd0\expndtw-4\cgrid (cfr. scheda n\'b0364 e segg.) pur con inaspettati riscontri di}{\fs20\expnd0\expndtw-2\cgrid  freschezza e vivacit\'e0, come per l}{\fs20\expnd0\expndtw-2\super\cgrid '}{\fs20
\expnd0\expndtw-2\cgrid abbozzo delle }{\fs18\expnd3\expndtw16\i\cgrid Tamerici }{\fs20\expnd0\expndtw-2\cgrid in giardino del 1982 (cfr. scheda n\'b0373).
\par }\sa324\nowidctlpar\adjustright {\fs20\expnd-1\expndtw-5\cgrid In estate, come }{\fs20\expnd0\expndtw-2\cgrid d}{\fs20\expnd-1\expndtw-5\super\cgrid '}{\fs20\expnd-1\expndtw-5\cgrid abitudine da alcuni anni, lunghe vacanze}{\fs20\expnd0\expndtw-2
\cgrid  sulle Dolomiti consentono il confronto con forme di paesaggio poco familiari che esercitano sulla pittrice un }{\fs20\expnd0\expndtw-4\cgrid fascino potente e non di rado si trasformano in soggetti da}{\fs20\expnd0\expndtw-2\cgrid  dipingere. Infa
tti dopo la serie degli anni }{\fs20\expnd0\expndtw-2\super\cgrid '}{\fs20\expnd0\expndtw-2\cgrid 66 -}{\fs20\expnd0\expndtw-2\super\cgrid '}{\fs20\expnd0\expndtw-2\cgrid 67 (cfr. schede nn\'b0 188/190 e oltre) che propone le asperit\'e0 montagnose sulla 
traccia dell}{\fs20\expnd0\expndtw-2\super\cgrid '}{\fs20\expnd0\expndtw-2\cgrid esperienza norvegese, il nuovo viaggio del 1976 (cfr. schede n\'b0 314 e n\'b0 315) ripercorre paesaggi gi\'e0 esplorati in una dimensione pi\'f9 }{\fs20\expnd0\expndtw-4
\cgrid descrittiva, addolcita, come successivamente nel 1979 (cfr.}{\fs20\expnd0\expndtw-2\cgrid  }{\fs20\expnd-1\expndtw-6\cgrid schede nn\'b0341 e 342). Ricorre il lago, pi\'f9 del mare presente}{\fs20\expnd0\expndtw-2\cgrid 
\par }\pard\plain \qc\nowidctlpar\adjustright \fs24\cgrid {{\pict{\*\picprop\shplid1024{\sp{\sn shapeType}{\sv 75}}{\sp{\sn fFlipH}{\sv 0}}{\sp{\sn fFlipV}{\sv 0}}{\sp{\sn pibName}{\sv pag 25_Pic0}}{\sp{\sn pibFlags}{\sv 1}}{\sp{\sn fillColor}{
